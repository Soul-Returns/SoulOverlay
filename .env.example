# Copy this file to .env and fill in your UEX Corp API key.
# Get a free key at: https://uexcorp.space/api
#
# The API key is only needed at build time (docker compose build).
# The running container serves pre-fetched static data — no runtime API calls.
#
# Then run:
#   docker compose up -d --build

UEX_API_KEY=your_api_key_here
